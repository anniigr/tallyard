{
  "uid": "tallyard-ops",
  "title": "Tallyard \u2014 Operations",
  "tags": [
    "tallyard"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
