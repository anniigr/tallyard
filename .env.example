# Copy to .env (git-ignored) before `docker compose up`. All values below are harmless placeholders.

# PostgreSQL password used by the containers (local development only).
TALLYARD_DB_PASSWORD=tallyard

# Required: base64 of 32 random bytes; encrypts webhook signing secrets at rest.
# Generate your own:  openssl rand -base64 32
TALLYARD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# Protects POST /v1/admin/tenants. Leave empty to disable tenant creation over HTTP.
TALLYARD_BOOTSTRAP_TOKEN=

# Demo tenant seeded on first start by the API node.
TALLYARD_DEMO_ENABLED=true
# Optional fixed ADMIN+INGEST key for the demo tenant: must be "ty_" followed by exactly 40 [A-Za-z0-9] chars.
TALLYARD_DEMO_ADMIN_KEY=ty_demo000000000000000000000000000000000000
TALLYARD_DEMO_PERIOD_MINUTES=10
TALLYARD_DEMO_GRACE_SECONDS=30

# Trace sampling ratio for OpenTelemetry (1.0 = every request).
TALLYARD_TRACE_SAMPLING=0.2
# Set to "ecs" or "logstash" for structured JSON logs; empty = human-readable.
TALLYARD_LOG_FORMAT=

GRAFANA_ADMIN_PASSWORD=admin
